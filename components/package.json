{
  "name": "mampfio-design-system",
  "private": true,
  "version": "0.0.0",
  "description": "Mampfio design system: tokens, fonts, logos, and Bootstrap 5 as an implementation detail.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "check:bootstrap": "node scripts/check-bootstrap-overrides.mjs",
    "css": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import --no-source-map scss/mampfio.scss dist/css/mampfio.css",
    "css:min": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import --style=compressed --no-source-map scss/mampfio.scss dist/css/mampfio.min.css",
    "copy": "node scripts/copy-assets.mjs",
    "build": "npm run tokens && npm run check:bootstrap && npm run css && npm run css:min && npm run check:theme && npm run copy && npm run icons",
    "check:theme": "node scripts/check-theme.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "sass": "1.105.2"
  }
}
